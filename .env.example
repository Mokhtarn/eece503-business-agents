# Copy to .env locally; DO NOT commit actual credentials.
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-6-luna
# GPT-6 Luna Chat Completions requests use reasoning_effort="none" in code.
# Cost defaults: 64-token LLM router, local retrieval, 1,024-token answers, no retries.
# Optional: logs default to this repository's gitignored logs/ directory.
# AGENT_LOG_DIR=logs
# GRADIO_SERVER_PORT=7860
